#include <zephyr/dt-bindings/led/led.h>

/ {
    zephyr,user {
        io-channels = <&adc1 3>;
    };
    aliases{
        led-strip = &led_strip;
        mosfet1 = &mosfet1;
    };

    gpio_keys {
        compatible = "gpio-keys";

        mosfet1: mosfet_1{
            label = "Mosfet_1";
            gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
        };
    };
};

&i2s0_default {
    group1 {
        pinmux = <I2S0_O_SD_GPIO48>;
    };
};

&i2s0 {
    status = "okay";

    dmas = <&dma 3>;
    dma-names = "tx";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-i2s";
        reg = <0>;
        chain-length = <1>;

        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;

        reset-delay = <500>;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <400000>;
};

&adc1{
    status = "okay";
};

&dma {
    status = "okay";
};

